.section { padding: 24rpx; }
.card, .match-card { background: #ffffff; border-radius: 12rpx; padding: 28rpx; margin-bottom: 18rpx; box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05); }
.create-card { border-left: 6rpx solid #16a085; }
.title { font-size: 32rpx; font-weight: 700; margin-bottom: 18rpx; color: #111827; }
.row { display: flex; justify-content: space-between; align-items: center; }
.strong { font-weight: 700; color: #111827; }
.meta { color: #6b7280; margin-top: 10rpx; font-size: 26rpx; }
.field { margin-top: 16rpx; }
.field text { display: block; color: #374151; margin-bottom: 8rpx; font-size: 26rpx; }
.field input { background: #f3f4f6; border-radius: 8rpx; padding: 16rpx; min-height: 44rpx; }
.field-row { display: flex; gap: 16rpx; }
.half { flex: 1; }
.primary { margin-top: 22rpx; background: #16a085; color: #ffffff; border-radius: 10rpx; }
.muted { color: #6b7280; }
