.detail { background: #ffffff; border-radius: 12rpx; padding: 28rpx; }
.title { font-size: 34rpx; font-weight: 700; margin-bottom: 18rpx; }
.line { color: #374151; margin-top: 12rpx; word-break: break-all; }
.price { color: #0f766e; font-size: 36rpx; font-weight: 700; margin: 22rpx 0; }
.primary, .secondary, .ghost { border-radius: 10rpx; text-align: center; padding: 18rpx; font-size: 30rpx; margin-top: 18rpx; }
.primary { background: #111827; color: #ffffff; }
.secondary { background: #16a085; color: #ffffff; }
.ghost { background: #f3f4f6; color: #111827; }
.muted { color: #6b7280; }
