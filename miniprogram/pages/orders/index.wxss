.order-card {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.strong { font-weight: 700; }
.meta { margin-top: 10rpx; color: #6b7280; font-size: 26rpx; }
.amount { margin-top: 14rpx; color: #0f766e; font-size: 32rpx; font-weight: 700; }
.muted { color: #6b7280; }