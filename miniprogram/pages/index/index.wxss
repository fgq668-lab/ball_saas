.hero {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 12rpx;
  color: #6b7280;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}

.action {
  background: #ffffff;
  color: #111827;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e5e7eb;
}

.action.primary {
  background: #16a085;
  color: #ffffff;
}

