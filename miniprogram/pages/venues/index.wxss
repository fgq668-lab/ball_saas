.venue-card {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.venue-name {
  font-size: 32rpx;
  font-weight: 700;
}

.venue-meta {
  margin-top: 10rpx;
  color: #6b7280;
}

.book-btn {
  margin-top: 20rpx;
  background: #16a085;
  color: #ffffff;
  text-align: center;
  border-radius: 10rpx;
  padding: 18rpx;
}

.muted {
  color: #6b7280;
}