.section { padding: 24rpx; }
.card { background: #ffffff; border-radius: 12rpx; padding: 28rpx; margin-bottom: 18rpx; box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05); }
.title { font-size: 34rpx; font-weight: 700; margin-bottom: 18rpx; color: #111827; }
.field { margin-top: 18rpx; }
.field text { display: block; color: #374151; margin-bottom: 8rpx; font-size: 26rpx; }
.field input, .field textarea { width: 100%; box-sizing: border-box; background: #f3f4f6; border-radius: 8rpx; padding: 16rpx; min-height: 44rpx; }
.field textarea { height: 130rpx; }
.primary { margin-top: 24rpx; background: #16a085; color: #ffffff; border-radius: 10rpx; }
.line { color: #374151; margin-top: 12rpx; }
.result { border-left: 6rpx solid #16a085; }
